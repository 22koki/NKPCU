# These are environment variables. Django does not automatically load this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
# Set a long random secret for deployment:
# DJANGO_SECRET_KEY=
# Optional PostgreSQL; without POSTGRES_DB, SQLite is used:
# POSTGRES_DB=nkpcu_ict
# POSTGRES_USER=nkpcu_ict
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
